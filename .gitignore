# Environments / editor / caches
.venv/
.vscode/
__pycache__/
.pytest_cache/
node_modules/

# Run logs and scratch
*.log
archive/run_logs/

# Datasets and large arrays (rebuild via data/README.md)
data/*
!data/README.md
*.npy
*.npz
*.parquet
*.pcap

# Model weights and trained checkpoints
*.pth
*.pt
*.joblib
*.pkl
*.cbm
vae_training/runs/latents/

# Bulk CSVs, but keep committed results
*.csv
!vae_training/runs/frontier/*.csv
!vae_training/runs/figures/*.csv

# LaTeX build products (main.pdf IS committed - it is the deliverable)
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.out
paper/*.synctex.gz
paper/.refcache.json
